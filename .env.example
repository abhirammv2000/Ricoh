# Citera environment
# Copy this file to `.env` and fill in your values.  `.env` is gitignored.

# REQUIRED: Anthropic API key for the LLM (planner / verifier / synthesizer).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL: LLM provider. Supported: anthropic (default). google/openai are stubs.
# LLM_PROVIDER=anthropic

# OPTIONAL: Point ingestion at a different PDF folder (defaults to ./data).
# RICOH_DATA_DIR=/absolute/path/to/pdfs

# OPTIONAL: Enable the cross-encoder reranker (needs requirements-reranker.txt).
# RERANKER_ENABLED=true
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# OPTIONAL: LangSmith tracing. Off by default so the repo runs without an
# account. Set these to send a hosted timeline of every agent run to LangSmith,
# alongside the file-based traces in traces/. Get a key at smith.langchain.com.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your-key-here
# LANGCHAIN_PROJECT=citera
