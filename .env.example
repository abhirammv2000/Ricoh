# Citera environment
# Copy this file to `.env` and fill in your values.  `.env` is gitignored.

# REQUIRED: Anthropic API key for the LLM (planner / verifier / synthesizer).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL: LLM provider. Supported: anthropic (default). google/openai are stubs.
# LLM_PROVIDER=anthropic

# OPTIONAL: Point ingestion at a different PDF folder (defaults to ./data).
# RICOH_DATA_DIR=/absolute/path/to/pdfs

# OPTIONAL: Enable the cross-encoder reranker (needs requirements-reranker.txt).
# RERANKER_ENABLED=true
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# OPTIONAL: LangSmith tracing. Off by default so the repo runs without an
# account. Set these to send a hosted timeline of every agent run to LangSmith,
# alongside the file-based traces in traces/. Get a key at smith.langchain.com.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your-key-here
# LANGCHAIN_PROJECT=citera

# OPTIONAL: Semantic answer cache. Off by default. When on, an identical or
# near-duplicate question returns a stored answer instead of paying for the
# synthesizer again. The threshold is measured, not guessed (see src/config.py).
# SEMANTIC_CACHE_ENABLED=true
# SEMANTIC_CACHE_THRESHOLD=0.90
# SEMANTIC_CACHE_MAX_ENTRIES=512

# OPTIONAL: Public-demo protection (app/guard.py). The query rate limit is
# enforced only when DEMO_MODE is set, and bounds the whole app's query rate so
# one visitor cannot run up the API bill. Set APP_PASSWORD to put the demo behind
# a shared password (unset means open).
# APP_RATE_LIMIT_RPS=0.1
# APP_RATE_LIMIT_BURST=10
# APP_PASSWORD=change-me

# OPTIONAL: Tool-calling retrieval (src/tools.py). When on, the model runs its
# own searches via a search_docs tool and re-queries when the passages it gets
# back do not answer the question. Recovers 4 of the 6 questions that fail
# retrieval at n=100, with no regressions in a 20-question sample, at 1.77x the
# cost per query. Off by default: that measurement is retrieval-only and the
# judged n=100 run has not been done.
# USE_TOOL_LOOP=true
