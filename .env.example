# Citera settings. Copy this file to .env and fill in what you need. .env is gitignored.
#
# Lines starting with # are optional and show the default (or an example). The real environment always
# beats .env, so a deployed service sets these on the platform and does not ship a .env file.
# On a laptop, an old key in your shell can hide the one in .env. Turn this on to let .env win.
# DOTENV_OVERRIDE=false

# --- Model provider -------------------------------------------------------------------------------

# Required. The answering model and the judge both use Anthropic.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which provider answers questions: anthropic (default), openai, google or self_hosted. The judge always
# stays on Anthropic. openai and google need `pip install -r requirements-providers.txt`.
# LLM_PROVIDER=anthropic
# OPENAI_API_KEY=sk-proj-your-key-here
# GEMINI_API_KEY=your-gemini-key-here      # GOOGLE_API_KEY works too
# self_hosted is the QLoRA fine-tune in finetune/ served with vLLM. It needs an address and no key.
# SELF_HOSTED_LLM_BASE_URL=http://localhost:8000/v1

# How long one model call may take, and how often it is retried. Keep timeout x (retries + 1) under
# REQUEST_TIMEOUT_SECONDS below, or a slow provider turns into a 504.
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=3

# The model that scores answers in the evaluation scripts.
# JUDGE_MODEL=claude-opus-5
# JUDGE_MAX_TOKENS=8192

# --- Documents and index --------------------------------------------------------------------------

# Where the PDFs are, and where the index is written.
# RICOH_DATA_DIR=/absolute/path/to/pdfs
# CHROMA_DIR=/absolute/path/to/index

# Embedding model for the vector index. Empty means the MiniLM model that ships with chromadb.
# Changing it means rebuilding the index, and the service refuses to start on a mismatch.
# EMBEDDING_MODEL=

# Cross-encoder reranker. Off by default because it needs torch (requirements-reranker.txt).
# RERANKER_ENABLED=true
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Azure AI Search instead of the local index (src/azure_retriever.py, requirements-azure.txt).
# The Free tier is enough for this corpus.
# AZURE_SEARCH_ENDPOINT=https://your-service.search.windows.net
# AZURE_SEARCH_API_KEY=your-admin-key
# AZURE_SEARCH_INDEX=citera-chunks

# --- How the agent answers ------------------------------------------------------------------------

# Everything here is off by default. The numbers behind each choice are in docs/EVALUATION.md.
# USE_PLANNER=true     # splits a question into sub-queries. Helped on dev, not on held-out, costs 1.7x more.
# USE_VERIFIER=true    # checks the evidence and retries. It added nothing in the tests.
# USE_ROUTER=true      # one cheap call first, the tool loop only when that call refuses.
# USE_TOOL_LOOP=true   # the model runs its own searches. Recovered 4 of the 6 retrieval misses at n=100
#                      # for 1.77x the cost, measured on retrieval only (no judged run yet).

# Answer cache. An identical or near-identical question gets the stored answer and skips the model.
# SEMANTIC_CACHE_ENABLED=true
# SEMANTIC_CACHE_THRESHOLD=0.90
# SEMANTIC_CACHE_MAX_ENTRIES=512

# --- The HTTP API (api/main.py) -------------------------------------------------------------------

# Who may call. Comma separated, each `label:secret` or just a secret. The service will not start without
# keys. Use two keys at once to rotate without downtime. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEYS=partner:a-long-random-secret
# Laptop only. Runs with no keys.
# API_AUTH_DISABLED=false

# Limits. A bad value stops the service at startup and names the variable.
# REQUEST_TIMEOUT_SECONDS=30     # the longest one question may take
# MAX_CONCURRENT_QUERIES=16      # questions handled at once
# QUEUE_TIMEOUT_SECONDS=2        # how long an extra request waits for a slot before a 503
# RATE_LIMIT_RPS=1               # per key, requests a second
# RATE_LIMIT_BURST=10
# DAILY_BUDGET_USD=20            # most the model may cost in one UTC day. 0 turns it off. Per process.

# When the model is down, too slow or the budget is spent, answer with the passages found (true) or an error.
# FALLBACK_TO_RETRIEVAL=true
# Serve only an index that has a manifest and passes its checks.
# REQUIRE_INDEX_MANIFEST=true

# --- Logs and traces ------------------------------------------------------------------------------

# text, or json (one object per line, with the request id).
# LOG_FORMAT=text
# Where per-request traces go, and the size at which the file rotates.
# TRACE_DIR=/var/log/citera
# TRACE_MAX_BYTES=52428800
# What a trace keeps of the question: full, hash (a length and a hash) or none. Use hash on a server.
# TRACE_QUERY_MODE=full

# LangSmith tracing, on top of the local traces. Off by default so nothing needs an account.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your-key-here
# LANGCHAIN_PROJECT=citera

# --- The Streamlit demo (app/main.py) -------------------------------------------------------------

# With DEMO_MODE on, the page says it serves a subset of the documents and the query rate limit applies.
# The limit covers the whole app, so one visitor cannot run up the bill. APP_PASSWORD, if set, is a shared
# password for the page.
# DEMO_MODE=false
# APP_RATE_LIMIT_RPS=0.1
# APP_RATE_LIMIT_BURST=10
# APP_PASSWORD=change-me
