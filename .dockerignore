# Keep the build context (and image) small and secret-free.
.git/
.github/
venv/
.venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/

# Large binaries + the full local index — never baked in.
# demo_index/ is the deliberate exception: it is the small pre-built subset
# the container serves, without which the app has nothing to retrieve from.
data/
RPD-en-US/
chroma_db/
.chroma/
traces/

# Secrets
.env
.env.*

# Docs / notebooks not needed at runtime
notebooks/
*.md
!demo_index/manifest.json
evaluation_results.csv

# OS / editor junk
.vscode/
.idea/
.DS_Store
Thumbs.db
