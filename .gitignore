# ============================================================
# Citera .gitignore
# Purpose: Keep the repo clean of binaries, secrets, and
#          OS/editor artefacts. Tuned for a Python 3.11 +
#          ChromaDB + venv stack.
# ============================================================

# ---------- Python bytecode & caches ----------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ---------- Virtual environment ----------
venv/
.venv/
env/

# ---------- Distribution / packaging ----------
*.egg-info/
dist/
build/
*.egg

# ---------- IDE / editor ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Environment variables / secrets ----------
.env
.env.*
# …but DO track the template (contains no real secrets).
!.env.example

# ---------- Data directory ----------
# We DO NOT commit the ~300 MB of Ricoh PDFs (or any other
# binary data placed here), but we keep the folder itself
# via a tracked .gitkeep sentinel.
data/*
!data/.gitkeep

# Safety net: never commit the raw Ricoh PDF export folder if it is
# dropped at the repo root instead of being moved into data/.
RPD-en-US/

# ---------- ChromaDB local storage ----------
chroma_db/
.chroma/

# ---------- Jupyter notebook checkpoints ----------
.ipynb_checkpoints/

# ---------- OS junk ----------
.DS_Store
Thumbs.db
desktop.ini

# Transient eval run log
eval_run.log
eval_enhanced.log

# Request traces (regenerated by running the app)
traces/

# Raw per-config ablation dumps — regenerate with `python -m eval.ablation`.
# The .md reports and comparison.json are the committed evidence.
eval/ablation/*_*.json

# Personal judge-calibration worksheet — regenerate with
# `python -m eval.label_for_kappa --sample N`. Once filled in with real
# labels it is worth keeping: `git add -f eval/human_labels.json`.
eval/human_labels.json
